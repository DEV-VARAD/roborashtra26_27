# ─────────────────────────────────────────────────────────────────────────────
# Roborashtra – Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Cloudinary (REQUIRED for image delivery) ──────────────────────────────────
# Your Cloudinary cloud name (visible in your Cloudinary dashboard)
# Safe to expose client-side — only the cloud name, never secrets.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ── Cloudinary Upload API (SERVER-SIDE ONLY — never expose to client) ─────────
# Used exclusively by the POST /api/upload server route for signed uploads.
# Find these in your Cloudinary dashboard under Settings > API Keys.
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
